			<_rmmServerID type="a">1360821_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_FunctionGroup</_name>
			<_modifiedTimeWeak type="a">6.26.2026::11:14:25</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">This stereotype allows to group system functions stepwise in a group. It can be used as an interim grouping mechanism, before the system function will be shifted or copied to a logical system element. With this stereotype multiple functional hierarchies can be stored in the functional domain, as it could evolve stepwise for the system (A functional level hierarchy has nothing to do with the system level hierarchy which decomposed a system into its system elements).</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">6.26.2026::11:14:25</_modifiedTime>
