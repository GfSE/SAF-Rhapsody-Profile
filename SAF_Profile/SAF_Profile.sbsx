			<_name type="a">SAF_A2_ARAS</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect Argumentation Assurance Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The Argumentation Assurance Viewpoint presents claims backed up by arguments that are supported by evidence, together with the possibility to counter such claims in a similar manner.\par \pard\ltrpar Presentation:\par \pard\ltrpar A block definition diagram (BDD) featuring a claim-argument-evidence pattern (CAE).\par}</_textRTF>
				<Hyperlinks type="c">
					<IRPYRawContainer type="e">
						<IExternalHyperlink type="e">
							<_name type="a">Argumentation Assurance Viewpoint </_name>
							<_textType type="a">FREE</_textType>
							<_target type="a">https://saf.gfse.org/userdoc/Architecture Management Domain/Argumentation Assurance Viewpoint</_target>
						</IExternalHyperlink>
						
					</IRPYRawContainer>
				</Hyperlinks>
			</IDescription>
			</_description>
