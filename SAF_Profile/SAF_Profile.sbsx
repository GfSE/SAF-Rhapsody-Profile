			<_rmmServerID type="a">1363631_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_O3_OSTA</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect Operational State Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The viewpoint defines modes of operation for the prosed system (such as normal, on-road, degraded, war-time, maintenance, training etc.) which apply not only to the SOI but also to involved personnel.\par \pard\ltrpar An operational mode defines a potential life-cycle selection for the SOI which has a relevant impact for the SOI%E2%80%99s stakeholder/users w.r.t. to the operations. [tbd]\par \pard\ltrpar Presentation:\par \pard\ltrpar A block definition diagram (BDD) featuring states, and state transitions. Note: References to model elements that are dependent of states, or transitions shall be shown as callout, or compartment notation.\par}</_textRTF>
				<Hyperlinks type="c">
					<IRPYRawContainer type="e">
						<IExternalHyperlink type="e">
							<_name type="a">Operational State Viewpoint </_name>
							<_textType type="a">FREE</_textType>
							<_target type="a">https://saf.gfse.org/userdoc/Operational Domain/Operational State Viewpoint</_target>
						</IExternalHyperlink>
						
					</IRPYRawContainer>
				</Hyperlinks>
			</IDescription>
			</_description>
