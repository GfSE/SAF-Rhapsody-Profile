			<_rmmServerID type="a">1457713_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_P2_PETD</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect Physical Exchange Type Definition Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The Physical Exchange Type Definition Viewpoint captures type definitions on design level for any exchanged or stored items, e.g., information, material, or energy, of the Physical Domain. Its purpose is to define these item types, their properties and their relationships. It also shows the traceability of these items to the conceptual layer (Functional and Logical Domain)\par \pard\ltrpar \par \pard\ltrpar Presentations:\par \pard\ltrpar  \par {\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li360 A block definition diagram (BDD) featuring Physical Exchange Types, their properties and relationships.\par {\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li360 A tabular format listing the Physical Exchange Types, their properties and relationships.\par}</_textRTF>
				<Hyperlinks type="c">
					<IRPYRawContainer type="e">
						<IExternalHyperlink type="e">
							<_name type="a">Physical Exchange Type Definition Viewpoint </_name>
							<_textType type="a">FREE</_textType>
							<_target type="a">https://saf.gfse.org/userdoc/Physical Domain/Physical Exchange Type Definition Viewpoint</_target>
						</IExternalHyperlink>
						
					</IRPYRawContainer>
				</Hyperlinks>
			</IDescription>
			</_description>
