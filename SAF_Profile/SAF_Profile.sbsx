			<_rmmServerID type="a">2261815_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_C5_SIFD</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect System Interface Definition Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The System Interface Definition Viewpoint captures system wide concepts defining interfaces. It allows to adopt long-lived standards and to harmonize conceptual interface definitions to improve interchangeability, interoperability, and portability.\par \pard\ltrpar Presentations:\par \pard\ltrpar  \par {\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li360 A block definition diagram (BDD) featuring Conceptual Interface blocks with ports, and flow properties.\par {\pntext\f1\'B7\tab}{\*\pn\pnlvlblt\pnf1\pnindent0{\pntxtb\'B7}}\ltrpar\fi-360\li360 A tabular format listing Conceptual Interface blocks, their ports, and flow properties.\par}</_textRTF>
				<Hyperlinks type="c">
					<IRPYRawContainer type="e">
						<IExternalHyperlink type="e">
							<_name type="a">System Interface Definition Viewpoint </_name>
							<_textType type="a">FREE</_textType>
							<_target type="a">https://saf.gfse.org/userdoc/Conceptual Domain/System Interface Definition Viewpoint</_target>
						</IExternalHyperlink>
						
					</IRPYRawContainer>
				</Hyperlinks>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.19.2026::6:31:38</_modifiedTime>
			<_lastID type="a">3</_lastID>
