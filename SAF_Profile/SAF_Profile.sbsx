			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect Operational Capability Definition Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The Operational Capability Definition Viewpoint defines a taxonomy of Capabilities from a Stakeholder%E2%80%99s perspective including composition, specialization, and dependency relationships between Operational Capabilities.\par \pard\ltrpar Presentation:\par \pard\ltrpar A block definition diagram (BDD) featuring Operational Capabilities, their composition, specialization, and dependency relationships.\par}</_textRTF>
				<Hyperlinks type="c">
