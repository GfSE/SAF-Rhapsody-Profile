	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;@SuppressWarnings(&amp;quot;unchecked&amp;quot;)
List&amp;lt;IRPModelElement&amp;gt; references = cellElement.getReferences().toList();
return references
         .stream()
         .filter(el -&amp;gt; &amp;quot;SAF_ConformsStandard&amp;quot;.equals(el.getUserDefinedMetaClass()))
         .map(el -&amp;gt; ((IRPDependency)el).getDependent())
         .collect(Collectors.toList());&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
