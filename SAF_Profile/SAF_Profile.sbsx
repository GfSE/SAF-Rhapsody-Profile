&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
&lt;COLUMN id=&quot;4&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPStereotype&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;if (cellElement instanceof IRPStereotype) {
  @SuppressWarnings(&amp;quot;unchecked&amp;quot;)
  List&amp;lt;IRPModelElement&amp;gt; generalizations = (List&amp;lt;IRPModelElement&amp;gt;)((IRPStereotype)cellElement).getGeneralizations().toList();
  return generalizations;
}
return null;&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
&lt;COLUMN id=&quot;5&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;Model element&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;String layoutName = cellElement.getPropertyValue(&amp;quot;Model.Stereotype.InitialLayoutForTables&amp;quot;);
if (layoutName != null) {
  return rhpApp.activeProject().findNestedElementRecursive(layoutName,&amp;quot;TableLayout&amp;quot;);
}
return null;&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/PICKER&gt;
&lt;/IMPLEMENTATION&gt;
&lt;/COLUMN&gt;
&lt;COLUMN id=&quot;6&quot;&gt;
&lt;IMPLEMENTATION&gt;
	&lt;CLASSPATH&gt;
	&lt;/CLASSPATH&gt;
	&lt;IMPORTS&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPApplication&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPModelElement&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPTableView&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.List&lt;/IMPORT&gt;
		&lt;IMPORT&gt;java.util.stream.Collectors&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPDependency&lt;/IMPORT&gt;
		&lt;IMPORT&gt;com.telelogic.rhapsody.core.IRPStereotype&lt;/IMPORT&gt;
	&lt;/IMPORTS&gt;
	&lt;USER-DEFINED-METHOD isUserDefinedMethod=&quot;FALSE&quot;&gt;&lt;/USER-DEFINED-METHOD&gt;
	&lt;ALLOW-SELECTOR&gt;FALSE&lt;/ALLOW-SELECTOR&gt;
	&lt;ALLOW-NEW&gt;FALSE&lt;/ALLOW-NEW&gt;
	&lt;DISPLAY-PROPERTY&gt;Name&lt;/DISPLAY-PROPERTY&gt;
	&lt;RETURN-TYPE&gt;List of model elements&lt;/RETURN-TYPE&gt;
	&lt;GETTER&gt;
		&lt;CODE&gt;@SuppressWarnings(&amp;quot;unchecked&amp;quot;)
List&amp;lt;IRPDependency&amp;gt; dependencies = (List&amp;lt;IRPDependency&amp;gt;) cellElement.getDependencies().toList();
return dependencies
          .stream()
          .filter(el -&amp;gt; {
             @SuppressWarnings(&amp;quot;unchecked&amp;quot;)
             List&amp;lt;IRPStereotype&amp;gt; stereotypes = (List&amp;lt;IRPStereotype&amp;gt;)el.getStereotypes().toList();
             return stereotypes
                       .stream()
                       .anyMatch(s -&amp;gt; &amp;quot;StandardContent&amp;quot;.matches(s.getName()));
           })
          .map(el -&amp;gt; el.getDependsOn())
         .collect(Collectors.toList());
&lt;/CODE&gt;
	&lt;/GETTER&gt;
	&lt;SETTER&gt;
		&lt;CODE&gt;&lt;/CODE&gt;
	&lt;/SETTER&gt;
	&lt;PICKER&gt;
