												<IProperty type="e">
													<_Name type="a">SysMLDiagramKindTitle</_Name>
													<_Value type="a">P1_PCXD - bdd</_Value>
													<_Type type="a">String</_Type>
												</IProperty>
												
											</IRPYRawContainer>
										</Properties>
