													<_Value type="a">Icons/SAF_C3_SPRO_BB.ico</_Value>
													<_Type type="a">File</_Type>
												</IProperty>
												
												<IProperty type="e">
													<_Name type="a">DrawingToolbar</_Name>
													<_Value type="a">?&lt;IsConditionalProperty&gt;?&lt;begin&gt;$&lt;General::Graphics::$&lt;General::Model::SelectedPerspective&gt;_SAF_C3_SPROToolbar&gt;?&lt;!=&gt;?&lt;?&gt;$&lt;General::Graphics::$&lt;General::Model::SelectedPerspective&gt;_SAF_C3_SPROToolbar&gt;?&lt;:&gt;RpyDefault?&lt;end&gt;</_Value>
