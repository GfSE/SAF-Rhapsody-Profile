			<_rmmServerID type="a">1143297_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_O4_OCXI</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1252\deff0\deflang1031{\fonttbl{\f0\fnil\fcharset0 Arial;}}{\colortbl ;\red0\green0\blue0;\red0\green0\blue255;}\viewkind4\uc1\pard\ltrpar\cf1\fs20 Implementation of \cf2\ul\protect Operational Context Interaction Viewpoint \cf0\ulnone\protect0 \par \pard\ltrpar Purpose:\par \pard\ltrpar The Operational Context Interaction Viewpoint describes single threads of interaction between Operational Performers in an Operational Context on an operational domain level. \par \pard\ltrpar Note: The Operational Interaction Viewpoint may refine an Operational Story.\par \pard\ltrpar Presentation:\par \pard\ltrpar A sequence diagram featuring the flow of control between Operational Performers of an Operational Context to achieve one outcome of an Operational Story. \par \pard\ltrpar Note: This diagram depicts the sending and receiving of messages between the interacting entities called lifelines where time is represented along the vertical axis. The lifelines representatives are part properties typed by Operational Performers.\par}</_textRTF>
				<Hyperlinks type="c">
					<IRPYRawContainer type="e">
						<IExternalHyperlink type="e">
							<_name type="a">Operational Context Interaction Viewpoint </_name>
							<_textType type="a">FREE</_textType>
							<_target type="a">https://saf.gfse.org/userdoc/Operational Domain/Operational Context Interaction Viewpoint</_target>
						</IExternalHyperlink>
						
					</IRPYRawContainer>
				</Hyperlinks>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.19.2026::6:31:38</_modifiedTime>
			<_lastID type="a">3</_lastID>
			<_m2Classes type="c">
