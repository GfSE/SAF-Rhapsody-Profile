			<_rmmServerID type="a">2316582_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_F3_SFRE</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">&quot;The System Functional Refinement Viewpoint analyses decomposition of System Functions into System Partial Functions in order achieve understanding and agreement about the System functions sufficient to derive system  requirements.Representation:Activity Diagram featuring System Partial Functions, functional exchange between partial functions. There are explicitely no Swimlanes and no allocations to structure.&quot;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.19.2026::6:31:37</_modifiedTime>
