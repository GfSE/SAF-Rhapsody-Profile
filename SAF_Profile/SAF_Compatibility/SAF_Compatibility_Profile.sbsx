			<_name type="a">SAF_SystemFunctionContribution</_name>
			<_modifiedTimeWeak type="a">6.11.2026::9:29:32</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">This stereotype enables to describe a functional level hierarchy (Hint: Tag value &quot;Party&quot;=several system functions are required to fullfill a common system function SF1=SF1.1+SF1.2, &quot;Complete&quot;=a system function is equal to a system function SF1=SF1.1=SF1.2).</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">6.11.2026::9:29:32</_modifiedTime>
