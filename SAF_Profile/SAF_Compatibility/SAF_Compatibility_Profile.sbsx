			<REFERENCES>
				<BASE-STEREOTYPES>
					<VALUE-IDS>GUID_6c142614-3349-49e9-8c6b-0236be5f6b61_1612371150</VALUE-IDS>
				</BASE-STEREOTYPES>
			</REFERENCES>
			<ADDITIONAL-PROPERTIES>
				<TYPE-GROUP-LABEL>SAF_C8_EATR - EA Traceability Viewpoint</TYPE-GROUP-LABEL>
			</ADDITIONAL-PROPERTIES>
			<DESCRIPTION>
				<PLAIN-TEXT>&quot;The EA Traceability Viewpoint provides a mapping between SAF System Model elements and model elements of an upper Enterprise Architecture (EA) Model. The mapping is accomplished by three kinds of relations%0D
%0D
*a representation relation which states that an element of the SAF System Model and the related model element in the EA model represents the same entity.%0D
*a derivation relation, stating that an element of the SAF System Model is derived from an EA model element.%0D
*an informed relation, stating that an element of the SAF System Model is related to the respective EA Element.&quot;</PLAIN-TEXT>
			</DESCRIPTION>
		</ELEMENT>
