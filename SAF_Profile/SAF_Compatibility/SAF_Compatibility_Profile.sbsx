			<ADDITIONAL-PROPERTIES></ADDITIONAL-PROPERTIES>
			<DESCRIPTION>
				<PLAIN-TEXT>This stereotype enables to describe a functional level hierarchy (Hint: Tag value &quot;Party&quot;=several system functions are required to fullfill a common system function SF1=SF1.1+SF1.2, &quot;Complete&quot;=a system function is equal to a system function SF1=SF1.1=SF1.2).</PLAIN-TEXT>
			</DESCRIPTION>
