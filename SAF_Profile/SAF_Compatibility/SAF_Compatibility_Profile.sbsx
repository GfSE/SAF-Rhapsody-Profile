			<_rmmServerID type="a">2316597_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_F5_SIFD</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:37</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">&quot;The System Interface Definition Viewpoint captures system wide concepts defining interfaces. It allows to adopt long-lived standards and to harmonize conceptual interface definitions to improve interchangeability, interoperability, and portability.Representation:A block definition diagram (BDD) featuring Conceptual Interface blocks with ports, and flow properties.A tabular format listing Conceptual Interface blocks, their ports, and flow properties.&quot;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.19.2026::6:31:37</_modifiedTime>
