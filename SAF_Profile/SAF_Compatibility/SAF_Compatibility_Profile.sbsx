			<VIEW-PARENTS></VIEW-PARENTS>
			<VIEW-CHILDREN></VIEW-CHILDREN>
			<AGGREGATES></AGGREGATES>
			<REFERENCES></REFERENCES>
			<ADDITIONAL-PROPERTIES>
				<TYPE-GROUP-LABEL>SAF_F3_SFRE - System Functional Refinement</TYPE-GROUP-LABEL>
			</ADDITIONAL-PROPERTIES>
			<DESCRIPTION>
				<PLAIN-TEXT>&quot;The System Functional Refinement Viewpoint analyses decomposition of System Functions into System Partial Functions in order achieve understanding and agreement about the System functions sufficient to derive system  requirements.Representation:Activity Diagram featuring System Partial Functions, functional exchange between partial functions. There are explicitely no Swimlanes and no allocations to structure.&quot;</PLAIN-TEXT>
			</DESCRIPTION>
		</ELEMENT>
		<ELEMENT>
			<ID>2316571_pDnuAbU4Ee6Ru6Ifm1D6NA</ID>
