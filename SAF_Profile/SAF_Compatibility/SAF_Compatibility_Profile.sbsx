			<_rmmServerID type="a">2316689_pDnuAbU4Ee6Ru6Ifm1D6NA</_rmmServerID>
			<_name type="a">SAF_C8_EATR</_name>
			<_modifiedTimeWeak type="a">10.19.2026::6:31:38</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">&quot;The EA Traceability Viewpoint provides a mapping between SAF System Model elements and model elements of an upper Enterprise Architecture (EA) Model. The mapping is accomplished by three kinds of relations%0D
%0D
*a representation relation which states that an element of the SAF System Model and the related model element in the EA model represents the same entity.%0D
*a derivation relation, stating that an element of the SAF System Model is derived from an EA model element.%0D
*an informed relation, stating that an element of the SAF System Model is related to the respective EA Element.&quot;</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">10.19.2026::6:31:38</_modifiedTime>
			<_m2Classes type="c">
