					<VALUE-IDS>GUID_6c142614-3349-49e9-8c6b-0236be5f6b61_1612371150</VALUE-IDS>
				</BASE-STEREOTYPES>
			</REFERENCES>
			<ADDITIONAL-PROPERTIES>
				<TYPE-GROUP-LABEL>SAF_F5_SIFD - System Interface Definition</TYPE-GROUP-LABEL>
			</ADDITIONAL-PROPERTIES>
			<DESCRIPTION>
				<PLAIN-TEXT>&quot;The System Interface Definition Viewpoint captures system wide concepts defining interfaces. It allows to adopt long-lived standards and to harmonize conceptual interface definitions to improve interchangeability, interoperability, and portability.Representation:A block definition diagram (BDD) featuring Conceptual Interface blocks with ports, and flow properties.A tabular format listing Conceptual Interface blocks, their ports, and flow properties.&quot;</PLAIN-TEXT>
			</DESCRIPTION>
		</ELEMENT>
