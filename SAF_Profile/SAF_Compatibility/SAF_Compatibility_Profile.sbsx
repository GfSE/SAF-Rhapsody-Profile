				<IRPYRawContainer type="e">
					<value>StructureDiagram</value>
				</IRPYRawContainer>
			</_m2Classes>
			<_newTerm type="a">1</_newTerm>
			<AggregatesList type="e">
				<value>GUID eb038fb4-b7b9-438d-ac1c-96b7b3b5ecfa</value>
			</AggregatesList>
